# 이 파일을 .env.local로 복사해 아래 세 경우 중 하나만 쓴다.
# (VITE_* 값은 dev 서버를 다시 시작해야 반영된다)

# ── 1) 개발 · 배포 백엔드에 프록시로 연결 (기본) ─────────────
# VITE_API_BASE_URL을 비우면 /api/... 상대 경로로 호출하고,
# vite 프록시가 VITE_PROXY_TARGET(기본 https://api.jigeumgayong.site)으로 넘긴다.
# 배포 서버 CORS는 localhost를 허용하지 않으므로 개발 중에는 이 방식을 쓴다.
VITE_API_BASE_URL=
VITE_USE_MOCK=false

# ── 2) 개발 · 로컬 백엔드(H2, ..\backend 에서 gradlew bootRun) ──
# VITE_API_BASE_URL=
# VITE_PROXY_TARGET=http://localhost:8080
# VITE_USE_MOCK=false

# ── 3) 프로덕션 빌드 (Vercel 환경변수에 설정) ─────────────────
# VITE_API_BASE_URL=https://api.jigeumgayong.site
# VITE_USE_MOCK=false

# 백엔드 없이 화면만 볼 때: VITE_USE_MOCK=true (src/data/mockFacilities.ts 사용)

# ── 카카오맵 (모든 경우 공통) ────────────────────────────────
# 카카오 개발자 콘솔 > 앱 > JavaScript 키. Vercel 환경변수에도 같은 이름으로 넣는다.
# JavaScript SDK 도메인에 등록된 곳(http://localhost:5173, https://www.jigeumgayong.site)에서만 지도가 뜨고,
# 키가 비었거나 미등록 도메인(Vercel Preview 등)이면 간이 지도(fallback)로 표시된다.
VITE_KAKAO_JS_KEY=
